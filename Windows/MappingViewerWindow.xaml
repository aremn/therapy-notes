<Window x:Class="AudioRecorderTrayApp.MappingViewerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Просмотр mapping (локально)" Height="420" Width="640" WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="Transparent">
  <Border Background="{DynamicResource AppBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="12" Margin="16" ClipToBounds="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="44" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid Grid.Row="0" Background="{DynamicResource CardBackground}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Background="Transparent" MouseDown="TitleBar_MouseDown" />
        <Button Grid.Column="1" x:Name="CloseButton" Click="OnCloseClick" Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{DynamicResource WindowCloseButtonStyle}" Padding="0" ToolTip="Закрыть">
          <materialDesign:PackIcon xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" Kind="Close" Width="16" Height="16" />
        </Button>
      </Grid>
      <Grid Grid.Row="1" Margin="16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="Session Id:" VerticalAlignment="Center" Margin="0,0,6,0" />
          <TextBox x:Name="IdBox" Width="380" VerticalAlignment="Center" />
          <Button Content="Загрузить" Click="OnLoadClick" Margin="8,0,0,0" />
          <Button Content="Открыть папку" Click="OnOpenFolderClick" Margin="8,0,0,0" />
        </StackPanel>
        <TextBox x:Name="OutputBox" Grid.Row="1" Margin="0,8,0,8" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Закрыть" Click="OnCloseClick" />
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>