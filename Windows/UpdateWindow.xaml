<Window x:Class="AudioRecorderTrayApp.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Загрузчик" Height="150" Width="400"
        WindowStyle="None" ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#2E2E2E">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock x:Name="StatusText" Text="Проверка обновлений..." 
                       Foreground="WhiteSmoke" FontSize="16" Margin="10"/>
            <ProgressBar IsIndeterminate="True" Height="5" Margin="10,0,10,10"/>
        </StackPanel>
    </Grid>
</Window>