<Window x:Class="AudioRecorderTrayApp.ClientManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:AudioRecorderTrayApp.Converters"
  Title="Управление клиентами" Height="680" Width="920"
        WindowStartupLocation="CenterOwner" 
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True">
  <Border Background="{DynamicResource AppBackground}" 
          BorderBrush="{DynamicResource BorderColor}" 
          BorderThickness="1" CornerRadius="16" Margin="16">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid Grid.Row="0" Background="Transparent" MouseDown="TitleBar_MouseDown">
  <TextBlock Text="Управление клиентами" 
               FontSize="18" FontWeight="SemiBold"
               Foreground="{DynamicResource TextPrimary}"
               HorizontalAlignment="Left" VerticalAlignment="Center"
               Margin="24,16,0,16"/>

  <Button Style="{StaticResource WindowCloseButtonStyle}"
      Click="CloseButton_Click"
      ToolTip="Закрыть"
      HorizontalAlignment="Right"
      VerticalAlignment="Top"
      Margin="0,12,12,0">
    <materialDesign:PackIcon Kind="CloseThick" Width="14" Height="14"/>
  </Button>
    </Grid>
      
    <Border Grid.Row="1" Height="1" Background="{DynamicResource BorderColor}" 
            HorizontalAlignment="Stretch" VerticalAlignment="Top"/>
      
    <Grid Grid.Row="1" Margin="24,24,24,20">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="20"/>
        <ColumnDefinition Width="420"/>
      </Grid.ColumnDefinitions>
      
      <Border Grid.Column="0" Background="{DynamicResource CardBackground}" 
              CornerRadius="12" Padding="20"
              BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
        <StackPanel>
          <TextBlock Text="Список клиентов" FontSize="16" FontWeight="SemiBold" 
                     Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,16"/>
          <ListView x:Name="ClientsList" Background="Transparent" BorderThickness="0"
                      SelectionMode="Single" MaxHeight="380" Padding="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      SelectionChanged="ClientsList_SelectionChanged">
            <ListView.ItemContainerStyle>
              <Style TargetType="ListViewItem">
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="16,12"/>
                <Setter Property="Margin" Value="0,0,0,8"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                      <Border x:Name="Bd"
                              Background="{DynamicResource AppBackground}"
                              BorderBrush="{DynamicResource BorderColor}"
                              BorderThickness="1"
                              Padding="{TemplateBinding Padding}"
                              SnapsToDevicePixels="true"
                              CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" 
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentColor}" />
                          <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColorBrush}" />
                          <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentColorBrush}" />
                          <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColorBrush}" />
                          <Setter Property="Foreground" Value="White" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="14"/>
                    <TextBlock Text="{Binding Description}" FontSize="12" 
                               Opacity="0.8" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding Description, Converter={x:Static converters:NullToVisibilityConverter.Instance}}"/>
                    <TextBlock Text="{Binding CreatedAtUtc, StringFormat='Создан: {0:dd.MM.yyyy}'}" 
                               FontSize="11" Opacity="0.7"/>
                  </StackPanel>
                  <Button Grid.Column="1" Tag="{Binding Id}"
                          Click="DeleteClient_Click" 
                          Background="Transparent" BorderThickness="0"
                          Foreground="{DynamicResource TextSecondary}"
                          Width="32" Height="32" ToolTip="Удалить клиента"
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Margin="4,0">
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="Transparent" CornerRadius="6">
                          <Path x:Name="IconPath" Data="M3,6 L5,6 L5,18 L19,18 L19,6 L21,6 M8,6 L8,4 C8,3.45 8.45,3 9,3 L15,3 C15.55,3 16,3.45 16,4 L16,6 M9,8 L9,16 M12,8 L12,16 M15,8 L15,16"
                                Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.5" 
                                Stretch="Uniform" Width="14" Height="14"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="#26FF4D4D"/>
                            <Setter TargetName="IconPath" Property="Stroke" Value="#FFEF4444"/>
                          </Trigger>
                          <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="#33FF3B30"/>
                            <Setter TargetName="IconPath" Property="Stroke" Value="#FFE53935"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Button.Template>
                  </Button>
                </Grid>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </StackPanel>
      </Border>
        
      <Border Grid.Column="2" Background="{DynamicResource CardBackground}" 
              CornerRadius="12" Padding="20"
              BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
        <StackPanel>
          <TextBlock x:Name="EditPanelTitle" Text="Добавить клиента" 
                     FontSize="16" FontWeight="SemiBold" 
                     Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
          <Border Height="1" Background="{DynamicResource BorderColor}" Margin="0,4,0,12"/>
          <StackPanel Margin="0">
            <TextBlock Text="Имя клиента" FontWeight="Medium" 
                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
            <TextBox x:Name="ClientNameTextBox"
                     Style="{StaticResource ModernTextBoxStyle}"
                     MaxLength="50" Height="48"
                     Margin="0,0,0,6"
                     GotFocus="TextBox_GotFocus"
                     LostFocus="TextBox_LostFocus"
                     TextChanged="ClientNameTextBox_TextChanged"/>
            <TextBlock x:Name="NameCharacterCount" Text="0/50" 
                       FontSize="11" Foreground="{DynamicResource TextSecondary}" 
                       HorizontalAlignment="Right" Margin="0,0,0,16"/>
            <TextBlock Text="Описание (необязательно)" FontWeight="Medium" 
                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
            <TextBox x:Name="ClientDescriptionTextBox"
                     Style="{StaticResource ModernTextAreaStyle}"
                     MaxLength="300" Height="120"
                     Margin="0,0,0,6"
                     GotFocus="TextBox_GotFocus"
                     LostFocus="TextBox_LostFocus"
                     TextChanged="ClientDescriptionTextBox_TextChanged"/>
            <TextBlock x:Name="DescriptionCharacterCount" Text="0/300" 
                       FontSize="11" Foreground="{DynamicResource TextSecondary}" 
                       HorizontalAlignment="Right" Margin="0,0,0,24"/>
            <Button x:Name="SaveClientButton" Content="Сохранить" 
                    Click="SaveClient_Click"
                    Style="{StaticResource PrimaryButton}"
                    Margin="0,0,0,8"/>
            <Button x:Name="CancelEditButton" Content="Отмена" 
                    Click="CancelEdit_Click" Visibility="Collapsed"
                    Style="{StaticResource SecondaryButton}"
                    Margin="0,0,0,0"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
    <Border Grid.Row="2" Background="{DynamicResource CardBackground}" 
            CornerRadius="0,0,16,16"
            BorderThickness="0,1,0,0" 
            BorderBrush="{DynamicResource BorderColor}" Padding="20,12">
      <Grid>
        <TextBlock x:Name="StatusText" Text="" 
                   Foreground="{DynamicResource TextSecondary}" 
                   VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Border>
</Window>