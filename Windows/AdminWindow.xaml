<Window x:Class="AudioRecorderTrayApp.AdminWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Админ-панель" Height="520" Width="760" WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="Transparent">
  <Border Background="{DynamicResource AppBackground}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="12" Margin="16" ClipToBounds="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="44" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Grid Grid.Row="0" Background="{DynamicResource CardBackground}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Background="Transparent" MouseDown="TitleBar_MouseDown"/>
        <Button Grid.Column="1" x:Name="CloseButton" Click="CloseButton_Click" Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center" HorizontalAlignment="Right" Style="{DynamicResource WindowCloseButtonStyle}" Padding="0" ToolTip="Закрыть">
          <materialDesign:PackIcon xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" Kind="Close" Width="16" Height="16" />
        </Button>
      </Grid>

      <ScrollViewer Grid.Row="1" Margin="16" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="Загрузка одиночного файла" FontSize="16" FontWeight="SemiBold"/>
          <Border Height="8"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FilePathBox" Grid.Column="0" IsReadOnly="True"/>
            <Button Grid.Column="1" Content="Выбрать..." Click="PickFile_Click" Margin="8,0,0,0"/>
          </Grid>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="Говорящий:" VerticalAlignment="Center"/>
            <ComboBox x:Name="SpeakerCombo" Width="160" Margin="8,0,0,0">
              <ComboBoxItem Content="client" IsSelected="True"/>
              <ComboBoxItem Content="therapist"/>
            </ComboBox>
          </StackPanel>
          <Button x:Name="TranscribeButton" Content="Транскрибировать" Click="Transcribe_Click" Margin="0,12,0,0"/>
          <Button x:Name="UploadTranscript" Content="Анализировать готовый транскрипт" Click="UploadTranscript_Click" Margin="0,12,0,0"/>
          <ProgressBar x:Name="ProgressBar" Height="6" Margin="0,8,0,0" Minimum="0" Maximum="100" Visibility="Collapsed"/>
          <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0" TextWrapping="Wrap"/>

          <Separator Margin="0,16,0,16"/>
          <TextBlock Text="Инструменты" FontSize="16" FontWeight="SemiBold"/>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Mapping Viewer" Click="OpenMappingViewer_Click"/>
            <Button Content="Dialogue Viewer" Click="OpenDialogueViewer_Click" Margin="8,0,0,0"/>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Border>
</Window>
