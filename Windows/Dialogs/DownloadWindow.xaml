<Window x:Class="AudioRecorderTrayApp.DownloadWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Загрузка модели" Height="150" Width="400" WindowStyle="None" AllowsTransparency="True" Background="Transparent" WindowStartupLocation="CenterScreen" ShowInTaskbar="False" Topmost="True">
  <Border Background="{DynamicResource PrimaryBackgroundColor}" CornerRadius="8" Margin="15" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
    <Border.Effect>
      <DropShadowEffect ShadowDepth="0" BlurRadius="15" Color="Black" Opacity="0.2" />
    </Border.Effect>
    <StackPanel Margin="20" VerticalAlignment="Center">
      <TextBlock x:Name="MessageLabel" Text="Скачиваю модель, пожалуйста, подождите..." Foreground="{DynamicResource PrimaryTextColor}" FontSize="14" Margin="0,0,0,10" />
      <ProgressBar x:Name="DownloadProgressBar" Height="20" />
    </StackPanel>
  </Border>
</Window>