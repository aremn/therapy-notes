<Window x:Class="AudioRecorderTrayApp.Windows.Dialogs.AddClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Добавить клиента"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Height="460" Width="580">
  <Border Background="{DynamicResource AppBackground}"
          BorderBrush="{DynamicResource BorderColor}"
          BorderThickness="1" CornerRadius="16" Margin="16">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

  <Grid Grid.Row="0" Background="Transparent" MouseDown="TitleBar_MouseDown">
        <TextBlock Text="Добавить клиента" FontSize="18" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimary}"
                   HorizontalAlignment="Left" VerticalAlignment="Center"
                   Margin="24,16,0,16"/>
        <Button Style="{StaticResource WindowCloseButtonStyle}"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,12,12,0"
                ToolTip="Закрыть"
                Click="Cancel_Click">
          <materialDesign:PackIcon Kind="CloseThick" Width="14" Height="14"/>
        </Button>
      </Grid>

      <Border Grid.Row="1" Height="1" Background="{DynamicResource BorderColor}"
              HorizontalAlignment="Stretch" VerticalAlignment="Top"/>

      <StackPanel Grid.Row="1" Margin="24,20,24,20">
        <TextBlock Text="Имя клиента:" FontWeight="Medium"
                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
  <TextBox x:Name="NameTextBox" Style="{StaticResource ModernTextBoxStyle}"
     Height="48" MaxLength="50" Margin="0,0,0,4" TextChanged="NameTextBox_TextChanged"/>
        <TextBlock x:Name="NameCharacterCount" Text="0/50" 
                   FontSize="11" Foreground="{DynamicResource TextSecondary}" 
                   HorizontalAlignment="Right" Margin="0,0,0,6"/>
        <TextBlock x:Name="NameErrorText" Foreground="#FFE53935" FontSize="12"
                   Visibility="Collapsed" Margin="0,0,0,16"/>

        <TextBlock Text="Описание (необязательно):" FontWeight="Medium"
                   Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
  <TextBox x:Name="DescriptionTextBox" Style="{StaticResource ModernTextAreaStyle}"
     Height="120" MaxLength="300" Margin="0,0,0,4"
     TextChanged="DescriptionTextBox_TextChanged"/>
        <TextBlock x:Name="DescriptionCharacterCount" Text="0/300" 
                   FontSize="11" Foreground="{DynamicResource TextSecondary}" 
                   HorizontalAlignment="Right" Margin="0,0,0,0"/>
      </StackPanel>

      <Border Grid.Row="2" Background="{DynamicResource CardBackground}"
              BorderBrush="{DynamicResource BorderColor}" BorderThickness="0,1,0,0"
              CornerRadius="0,0,16,16" Padding="24,12">
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button Content="Добавить" Style="{StaticResource PrimaryButton}" Height="40" MinHeight="40" Padding="16,8" Width="120"
      Click="Add_Click" Margin="0,0,8,0"/>
    <Button Content="Отмена" Style="{StaticResource SecondaryButton}" Height="40" MinHeight="40" Padding="16,8" Width="120"
      Click="Cancel_Click"/>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
